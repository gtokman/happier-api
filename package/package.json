{
  "name": "happier-api",
  "version": "0.1.0",
  "description": "Unofficial JavaScript/TypeScript client for the Happier Grocery (Jaldi/Vendora) commerce API",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "src",
    "openapi.yaml",
    "README.md"
  ],
  "keywords": [
    "happier",
    "grocery",
    "jaldi",
    "vendora",
    "ecommerce",
    "api-client"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
